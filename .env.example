# Ratchet environment contract. Copy to .env and fill in. Never commit .env.
# Every variable maps 1:1 to a field in ratchet/config/settings.py.
# Generated by scripts/gen_env_example.py from the Settings model: edit descriptions and
# defaults there, then run `uv run python scripts/gen_env_example.py`. Values already set
# in this file are kept when it is regenerated.

# --- Token Factory (proxy) --------------------------------------------------------------------
# Token Factory API key; read by the proxy only, never a sandbox.
NEBIUS_TOKEN_FACTORY_KEY=
# OpenAI-compatible Token Factory base URL (see docs/VERIFIED.md).
NEBIUS_TF_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Override the nano model id.
RATCHET_MODEL_NANO=
# Override the super model id.
RATCHET_MODEL_SUPER=
# Override the ultra model id.
RATCHET_MODEL_ULTRA=
# Override the embedding model id.
RATCHET_MODEL_EMBED=
# live = Token Factory; sim = the in-repo offline simulator (ADR 0018). Verdicts produced by the
# simulator carry a visible 'Simulated models' badge.
# One of: live | sim
RATCHET_UPSTREAM=sim
# Tier the agent runs on.
# One of: nano | super | ultra
RATCHET_AGENT_TIER=super
# Reasoning for agent calls when the harness sends no preference. Nemotron 3 thinks by default;
# off keeps replays cheap, fast and closer to deterministic.
# One of: off | on | default
RATCHET_AGENT_THINKING=off

# --- Local service URLs -----------------------------------------------------------------------
# Capture proxy.
RATCHET_PROXY_URL=http://127.0.0.1:8081/v1
# Mock tools.
RATCHET_MOCK_TOOLS_URL=http://127.0.0.1:8082
# Dashboard bind host.
RATCHET_DASHBOARD_HOST=127.0.0.1
# Dashboard + API port.
RATCHET_DASHBOARD_PORT=8080
# Proxy port.
RATCHET_PROXY_PORT=8081
# Mock tool server port.
RATCHET_MOCK_TOOLS_PORT=8082

# --- Storage and skills -----------------------------------------------------------------------
# Skills git repo.
RATCHET_SKILLS_REPO=./var/skills
# Store root.
RATCHET_DATA_DIR=./var/data
# Fernet key for the PII token map; defaults to <data>/../pii.key.
# RATCHET_PII_KEY_FILE=

# --- Replay -----------------------------------------------------------------------------------
# Job runner.
# One of: nebius | local
RATCHET_JOB_RUNNER=local
# How LocalJobRunner launches a worker (ADR 0017).
# One of: process | docker
RATCHET_LOCAL_RUNNER_MODE=process
# Replay sandbox. process is dev-only; refused in public mode.
# One of: openshell | docker | process
RATCHET_SANDBOX=process
# Harness adapter.
# One of: hermes | minimal
RATCHET_HARNESS=minimal
# Hermes version baked at install time; when unset the adapter runs `hermes --version` once per
# process.
RATCHET_HERMES_VERSION=
# Worker image.
RATCHET_WORKER_IMAGE=ratchet-worker:dev
# Worker sidecar upstream; defaults to nebius_tf_base_url.
RATCHET_TF_PROXY_UPSTREAM=
# Overwrite cassettes in record.
RATCHET_CASSETTE_REFRESH=false
# Goldens per replay batch.
RATCHET_BATCH_SIZE=10
# Goldens per batch for Simulate runs: more parallel workers, faster.
RATCHET_SIMULATE_BATCH_SIZE=4
# Selection cap.
RATCHET_MAX_TRACES_PER_EDIT=40
# Batch wall clock.
RATCHET_REPLAY_TIMEOUT_S=600
# Re-dispatch replays that crashed (harness/sandbox/worker) once.
RATCHET_REPLAY_RETRY_ONCE=true

# --- Nebius Serverless Jobs -------------------------------------------------------------------
# Nebius IAM token for Jobs.
NEBIUS_API_KEY=
# Nebius project (parent) id.
NEBIUS_PROJECT_ID=
# Nebius region.
NEBIUS_REGION=eu-north1
# Override Jobs API endpoint.
NEBIUS_JOBS_API_URL=
# Object storage endpoint.
NEBIUS_S3_ENDPOINT=
# Bucket for job inputs/outputs.
NEBIUS_S3_BUCKET=
# Object storage key.
NEBIUS_S3_ACCESS_KEY_ID=
# Object storage.
NEBIUS_S3_SECRET_ACCESS_KEY=
# Jobs compute preset/platform.
NEBIUS_JOB_PRESET=
# Managed bucket id (storagebucket-…) mounted into jobs without inline credentials;
# NEBIUS_S3_BUCKET stays the bucket name used for uploads.
NEBIUS_S3_BUCKET_ID=
# Jobs subnet; unset uses the project's default subnet.
NEBIUS_JOB_SUBNET_ID=
# Job boot disk in GiB; unset sends 20 GiB on cpu-* platforms and the platform default (250 GiB,
# billed) otherwise.
# NEBIUS_JOB_DISK_GIB=
# Override the worker image entrypoint (e.g. /app/.venv/bin/python); unset keeps the image's own
# entrypoint and sends only the worker arguments.
NEBIUS_JOB_CONTAINER_COMMAND=
# Serverless Jobs in flight at once (each job is a VM on quota).
RATCHET_JOBS_MAX_CONCURRENT=2
# How long a job submit waits for a free slot or quota before failing.
RATCHET_JOBS_SUBMIT_WAIT_S=900.0
# How long a submitted job may provision (VM, image pull) with no worker heartbeat before it
# counts as stalled; the 120 s heartbeat rule applies once it runs.
RATCHET_JOBS_PROVISION_S=900.0

# --- Tavily -----------------------------------------------------------------------------------
# Tavily key; judge only.
TAVILY_API_KEY=
# fixtures = recorded responses (bench, offline).
# One of: live | fixtures
RATCHET_TAVILY_MODE=fixtures
# Live Tavily searches per UTC day across the host (cache hits are free); past the cap drift
# checks report unavailable instead of spending more credits.
RATCHET_TAVILY_DAILY_SEARCHES=300
# Recorded Tavily responses.
RATCHET_TAVILY_FIXTURES_DIR=./tests/fixtures/tavily

# --- Judge ------------------------------------------------------------------------------------
# Tavily drift disambiguation.
RATCHET_FEATURE_DRIFT=true
# ADR 0023: replay contested pairs once more with the unchanged skill.
RATCHET_FEATURE_CONTROL_REPLAYS=true
# /v1/responses passthrough.
RATCHET_FEATURE_RESPONSES_API=false
# How thinking is toggled (docs/VERIFIED.md).
# One of: chat_template_kwargs | reasoning_effort | none
RATCHET_THINKING_STYLE=chat_template_kwargs
# Ultra reasoning budget.
RATCHET_ULTRA_REASONING_BUDGET=4000
# Judge response_format mode; auto tries json_schema, then json_object, then prompt-only JSON,
# remembering the degraded mode per tier (verified: json_schema works live on all tiers; the
# fallback stays as defence in depth).
# One of: auto | json_schema | json_object | prompt
RATCHET_STRUCTURED_MODE=auto
# Embedding for trigger-neighborhood selection.
# One of: local | tokenfactory
RATCHET_SELECTION_EMBEDDER=local
# Cosine threshold; default depends on the embedder.
# RATCHET_NEIGHBORHOOD_THRESHOLD=
# Model response cache TTL.
RATCHET_CACHE_TTL_DAYS=7

# --- Budget -----------------------------------------------------------------------------------
# All purposes, per UTC day.
RATCHET_DAILY_USD_CAP=10
# bench purpose hard cap, enforced all-time (cumulative bench spend in the bench store), not per
# day.
RATCHET_BENCH_USD_CAP=12
# JSON, e.g. {"agent": 5, "adjudicate": 3}.
RATCHET_PURPOSE_USD_CAPS={}

# --- Dashboard / public host ------------------------------------------------------------------
# Public base URL.
RATCHET_PUBLIC_URL=http://127.0.0.1:8080
# Disables bless/record.
RATCHET_PUBLIC_MODE=false
# Serve the Simulate HTTP routes (true on the demo host only). `ratchet simulate` on the
# operator's machine runs regardless.
RATCHET_SIMULATE_ENABLED=true
# replayed = stored verdicts, 'Recorded run' badge.
# One of: live | replayed
RATCHET_SIMULATE_MODE=live
# Concurrent Simulate sessions.
RATCHET_SIMULATE_MAX_SESSIONS=5
# Scenario auto-revert.
RATCHET_SIMULATE_RESET_S=600
# Queued Simulate runs before 429 simulate_busy.
RATCHET_SIMULATE_MAX_QUEUE=20
# Concurrent SSE streams per IP.
RATCHET_SSE_MAX_PER_CLIENT=3
# Concurrent SSE streams in total.
RATCHET_SSE_MAX_STREAMS=100
# Largest request body the API accepts (413 above).
RATCHET_API_MAX_BODY_BYTES=65536
# HMAC secret for the daily action token.
RATCHET_ACTION_TOKEN_SECRET=change-me
# Seeded scenarios.
RATCHET_SCENARIOS_DIR=./scenarios
# Built SPA.
RATCHET_DASHBOARD_DIST=./dashboard/dist
# Repo.
RATCHET_REPO_URL=https://github.com/lloydjf/ratchet
# Demo video URL for the landing footer.
RATCHET_VIDEO_URL=
# Link to bench/results/<date>/report.md on GitHub (README, Costs page).
RATCHET_BENCH_REPORT_URL=
# Reverse proxies trusted for X-Forwarded-For (rate limits).
RATCHET_FORWARDED_ALLOW_IPS=127.0.0.1

# --- Notifications and ops --------------------------------------------------------------------
# Slack/Telegram webhook (the URL carries its own credential).
RATCHET_NOTIFY_WEBHOOK=
# Content logging to a local file only.
RATCHET_DEBUG=false
# Log level.
RATCHET_LOG_LEVEL=INFO
# Concurrent edits.
RATCHET_MAX_EDITS_IN_FLIGHT=2

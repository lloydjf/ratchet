# /etc/caddy/Caddyfile — public entry for the Ratchet host (installed by bootstrap.sh and,
# when it validates, by deploy.sh). One Caddy, three names:
#
#   RATCHET_SITE_ADDRESS   apex, e.g. ratchetci.dev: the static product page, /docs/ (MkDocs),
#                          /bench/ (the benchmark report), from /var/www/ratchet-site
#   www.<apex>             301 to the apex; RATCHET_ALT_ADDRESSES (e.g. ratchetci.com and
#                          www.ratchetci.com) too, via /etc/caddy/ratchet.d/redirects/
#   RATCHET_DEMO_ADDRESS   demo host, e.g. demo.ratchetci.dev (host of RATCHET_PUBLIC_URL):
#                          the dashboard, API and SSE stream, reverse-proxied
#   RATCHET_UPSTREAM_ADDR  127.0.0.1:8080, or a standby VM during failover.sh proxy-to
#
# Values come from the caddy unit's environment, set by bootstrap.sh in
# /etc/systemd/system/caddy.service.d/ratchet.conf. A bare host => automatic HTTPS (HTTP-01
# on port 80, so DNS must point here without a proxy: deploy/vm/dns.md), HTTP->HTTPS
# redirect, renewals. ACME account email is optional (Caddy renews on its own); to get
# expiry notices add `email you@example.com` as the first line of the global options block.
#
# Static fallback (demo host only): served automatically when the app answers 502/503/504 or
# is unreachable, and for every request while /etc/caddy/ratchet-fallback.enabled exists
# (deploy/vm/failover.sh fallback on|off — no reload needed). /healthz is never masked by
# the fallback, so the external uptime monitor still sees the outage. The apex is static
# files only and keeps working while the app is down.
{
	servers {
		# The SSE stream holds connections open; do not let idle timeouts cut it.
		timeouts {
			read_header 10s
			idle 5m
		}
	}
	log default {
		output stdout
		format json
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-Via
	}
}

# Access log without query strings (session ids, `since`, tokens never reach a log):
# the URI is rewritten to the path only, and request headers/cookies are dropped.
# Argument: the file name under /var/log/caddy/.
(access_log) {
	log {
		output file /var/log/caddy/{args[0]} {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap json
			fields {
				request>uri regexp \?.*$ ""
				request>headers delete
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				resp_headers delete
			}
		}
	}
}

# --- apex: static product page, /docs/, /bench/ ------------------------------------------------
{$RATCHET_SITE_ADDRESS} {
	import security_headers
	import access_log ratchet-site-access.log
	encode zstd gzip

	# No inline scripts anywhere, except the docs theme's own, allowed by hash: deploy writes
	# `vars /docs/* docs_script_src "'sha256-...' ..."` here (render_site.py). Without it the
	# docs still read fine; only the theme's toggles stop working. Google Fonts: the docs
	# theme loads Inter and JetBrains Mono from there (the product page self-hosts them), and
	# its repository badge reads the star count from api.github.com.
	import /etc/caddy/ratchet.d/site/*.caddy
	header Content-Security-Policy "default-src 'self'; script-src 'self' {vars.docs_script_src}; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.github.com; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
	header Cache-Control "public, max-age=300"

	request_body {
		max_size 1KB
	}
	@write not method GET HEAD
	respond @write "Method not allowed" 405

	root * /var/www/ratchet-site
	file_server {
		hide .*
	}

	handle_errors 404 {
		root * /var/www/ratchet-site
		rewrite * /404.html
		file_server
	}
}

www.{$RATCHET_SITE_ADDRESS} {
	import security_headers
	redir https://{$RATCHET_SITE_ADDRESS}{uri} permanent
}

# Optional alt-domain redirects (RATCHET_ALT_ADDRESSES), written by bootstrap.sh.
import /etc/caddy/ratchet.d/redirects/*.caddy

# --- demo: the dashboard, API and SSE (public mode) -------------------------------------------
{$RATCHET_DEMO_ADDRESS} {
	import security_headers
	import access_log ratchet-access.log
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	encode zstd gzip

	# No API route takes more than a small JSON body (actions, demo events, criteria);
	# the app enforces the same limit (ratchet_api_max_body_bytes, 413 payload_too_large).
	request_body {
		max_size 64KB
	}

	@fallback_on file {
		root /etc/caddy
		try_files ratchet-fallback.enabled
	}

	handle /healthz {
		reverse_proxy {$RATCHET_UPSTREAM_ADDR:127.0.0.1:8080} {
			lb_try_duration 2s
		}
	}

	handle @fallback_on {
		root * /var/www/ratchet-fallback
		rewrite * /index.html
		header Cache-Control "no-store"
		file_server
	}

	# /metrics is for the VM (alerts.sh reads it on 127.0.0.1), not the internet.
	handle /metrics {
		respond "Not found" 404
	}

	# SSE (GET /api/v1/events/stream, /api alias per ADR 0019): unbuffered, no read timeout.
	@sse path /api/v1/events/stream /api/events/stream
	handle @sse {
		reverse_proxy {$RATCHET_UPSTREAM_ADDR:127.0.0.1:8080} {
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}

	handle {
		reverse_proxy {$RATCHET_UPSTREAM_ADDR:127.0.0.1:8080} {
			flush_interval -1
			lb_try_duration 5s
		}
	}

	handle_errors 502 503 504 {
		@health path /healthz
		handle @health {
			respond "upstream down" 503
		}
		handle {
			root * /var/www/ratchet-fallback
			rewrite * /index.html
			header Cache-Control "no-store"
			file_server
		}
	}
}

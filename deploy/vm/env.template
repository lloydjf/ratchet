# /etc/ratchet/env — the public demo host's settings (root:root 0600, read by systemd).
# Installed by deploy/vm/bootstrap.sh from deploy/vm/env.template; keys missing here are
# appended on every bootstrap run, existing values are never overwritten.
# Format: systemd EnvironmentFile (KEY=value, no `export`, no shell expansion).
# Every key maps to ratchet/config/settings.py; see .env.example for the full list.

# --- Token Factory (proxy only) --------------------------------------------------------
NEBIUS_TOKEN_FACTORY_KEY=
NEBIUS_TF_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# sim until the key is in; then live
RATCHET_UPSTREAM=sim
RATCHET_AGENT_TIER=super
RATCHET_THINKING_STYLE=chat_template_kwargs

# --- Paths (the service may write /srv/ratchet only) -------------------------------------
RATCHET_SKILLS_REPO=/srv/ratchet/skills
RATCHET_DATA_DIR=/srv/ratchet/data
RATCHET_PII_KEY_FILE=/srv/ratchet/pii.key
RATCHET_DASHBOARD_HOST=127.0.0.1
RATCHET_DASHBOARD_PORT=8080
RATCHET_PROXY_URL=http://127.0.0.1:8081/v1
RATCHET_MOCK_TOOLS_URL=http://127.0.0.1:8082

# --- Replay: local runner on the VM; Docker sandbox (process is refused in public mode) ---
RATCHET_JOB_RUNNER=local
RATCHET_LOCAL_RUNNER_MODE=process
RATCHET_SANDBOX=docker
RATCHET_HARNESS=minimal
RATCHET_WORKER_IMAGE=ratchet-worker:dev

# --- Nebius Serverless Jobs (optional; RATCHET_JOB_RUNNER=nebius) ------------------------
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
NEBIUS_REGION=eu-north1
NEBIUS_S3_ENDPOINT=
NEBIUS_S3_BUCKET=
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=

# --- Tavily (judge only) -----------------------------------------------------------------
TAVILY_API_KEY=
RATCHET_TAVILY_MODE=fixtures

# --- Budget --------------------------------------------------------------------------------
RATCHET_DAILY_USD_CAP=10
RATCHET_BENCH_USD_CAP=12
RATCHET_PURPOSE_USD_CAPS={}

# --- Public demo host -------------------------------------------------------------------------
# https://ratchet.<your-domain>; Caddy obtains the certificate for this host automatically.
RATCHET_PUBLIC_URL=
RATCHET_PUBLIC_MODE=true
# The Settings default is false; the demo host turns Simulate on explicitly.
RATCHET_SIMULATE_ENABLED=true
# live | replayed  (replayed = stored verdicts with a "Recorded run" badge; costs nothing)
RATCHET_SIMULATE_MODE=live
# Generated by bootstrap.sh; rotated weekly by ratchet-token-rotate.timer.
RATCHET_ACTION_TOKEN_SECRET=
RATCHET_REPO_URL=https://github.com/lloydjf/ratchet
RATCHET_VIDEO_URL=

# --- Notifications and ops -----------------------------------------------------------------------
RATCHET_NOTIFY_WEBHOOK=
RATCHET_DEBUG=false
RATCHET_LOG_LEVEL=INFO

# --- Ops scripts only (ignored by Settings) ---------------------------------------------------------
# Email for the ACME account (Let's Encrypt / ZeroSSL expiry notices); optional.
RATCHET_ACME_EMAIL=
# Nightly backup upload: bucket (defaults to NEBIUS_S3_BUCKET when empty) and key prefix.
RATCHET_BACKUP_S3_BUCKET=
RATCHET_BACKUP_S3_PREFIX=backups/ratchet
RATCHET_BACKUP_RETENTION_DAYS=14
